{
  "Logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20,
        "excludedTypes": "Exception"
      }
    },
    "LogLevel": {
      "default": "Information",
      "Host.Triggers": "Warning",
      "Host.Triggers.ServiceBus": "Warning",
      "Host.Results": "Warning",
      "Function": "Information",
      "Azure": "Warning",
      "Azure.Core": "Warning",
      "Azure.Storage.Blobs": "Error",
      "Azure.Messaging.ServiceBus": "Error",
      "Microsoft": "Warning",
      "Microsoft.Azure.WebJobs": "Warning",
      "Microsoft.Azure.WebJobs.ServiceBus": "Warning",
      "Microsoft.Azure.WebJobs.Script": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PeiRetrievalDuration": 60,
  "ViewDataRetrievalDuration": 5,
  "MapsCdaServiceUrl": "$(MapsCdaServiceUrl)",
  "TokenIntegrationServiceUrl": "$(TokenIntegrationServiceUrl)",
  "PensionRetrievalServiceUrl": "$(PensionRetrievalServiceUrl)",
  "RetrievedPensionsServiceUrl": "$(RetrievedPensionsServiceUrl)",
  "OpenApiServerUrl": "https://maps-api-management-dev.azure-api.net/pension-data-service/",
  "CosmosDBConnectionString": "$(CosmosDBConnectionString)",
  "RedisConnectionString": "$(RedisConnectionString)",
  "ServiceBusConnectionString": "$(ServiceBusConnectionString)",
  "APPLICATIONINSIGHTS_CONNECTION_STRING": "InstrumentationKey=0000-0000-0000-0000",
  "CosmosBusinessConfiguration": {
    "DatabaseId": "$(DatabaseId)",
    "UserSessionDataContainer": "$(UserSessionDataContainer)"
  },
  "CommonServiceBusConfiguration": {
    "OutboundQueue": "pensions-retrieval-job"
  },
  "ConnectionStrings": {
    "RedisConnectionString": "localhost:1000,abortConnect=False"
  }
}
