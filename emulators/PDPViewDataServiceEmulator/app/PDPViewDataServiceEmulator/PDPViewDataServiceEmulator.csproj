<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>e3822e3f-a17e-47fc-9f80-1690120d988e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MhpdCommon" Version="1.3.34" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="MhpdCommonHosting" Version="1.2.89" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="Support\ViewDataPayload\view_data_sample_1.json" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\swagger\v1" />
  </ItemGroup>
  
  <Target Name="OpenAPI" AfterTargets="Build" Condition="$(Configuration)=='Debug'">
      <Exec Command="dotnet swagger tofile --output ./wwwroot/swagger/v1/view-data-emulator.json $(OutputPath)$(AssemblyName).dll v1" WorkingDirectory="$(ProjectDir)" />
  </Target>
</Project>
