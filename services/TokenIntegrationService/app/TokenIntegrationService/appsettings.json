{
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CdaServiceUrl": "$(cdaServiceEndpoint)",
  "ConnectionStrings": {
    "CosmosDBConnectionString": "$(CosmosDBConnectionString)"
  },
  "ApplicationInsights": {
    "ConnectionString": "$(AppInsightsConnString)"
  },
  "CosmosIntegrationConfiguration": {
    "DatabaseId": "mhpd-integration-layer",
    "JwkCacheContainer": "jwkUriEmulatorData"
  }
}
